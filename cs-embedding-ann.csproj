<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <AssemblyName>cs-embedding-ann</AssemblyName>
    <RootNamespace>embedding_ann</RootNamespace>
    <Description>Approximate nearest neighbor search with HNSW</Description>
    <Authors>Mahmoud ElNemer</Authors>
    <PackageProjectUrl>https://github.com/ElNeMeR70/cs-embedding-ann</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ElNeMeR70/cs-embedding-ann</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
